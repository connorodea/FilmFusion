{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/animation-studio/episode.schema.json",
  "title": "Original 2D Animation Episode Contract",
  "description": "Canonical versioned episode specification consumed by a deterministic renderer. Cross-reference and timeline checks are defined in verify_kit.py, in addition to JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "show_id", "episode_id", "version", "status", "format", "title", "language", "fps", "canvas", "duration_frames", "show_bible_version", "assets", "characters", "shots", "publication"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "show_id": {"$ref": "#/$defs/identifier"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["draft", "script_approved", "shotplan_approved", "assets_approved", "audio_approved", "rendered", "qa_pass", "human_approved", "published"]},
    "format": {"type": "string", "enum": ["short", "long"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 150},
    "logline": {"type": "string", "minLength": 10, "maxLength": 1000},
    "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "fps": {"type": "integer", "enum": [24, 25, 30, 60]},
    "canvas": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 480, "maximum": 7680}, "height": {"type": "integer", "minimum": 480, "maximum": 4320}}
    },
    "duration_frames": {"type": "integer", "minimum": 30},
    "show_bible_version": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "characters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/character"}},
    "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}},
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "audience", "disclosure_review", "human_release_approved"],
      "properties": {
        "description": {"type": "string", "maxLength": 5000},
        "audience": {"type": "string", "enum": ["not_made_for_kids", "made_for_kids", "review_required"]},
        "disclosure_review": {"type": "string", "enum": ["pending", "not_required_reviewed", "disclosure_required"]},
        "human_release_approved": {"type": "boolean"},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 60}, "maxItems": 20},
        "thumbnail_asset_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}
      }
    },
    "creative_review": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "originality_notes": {"type": "string"},
        "brand_safety_notes": {"type": "string"},
        "reviewer_id": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "storage_ref", "rights"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"type": "string", "enum": ["background", "rig", "prop", "music", "sfx", "thumbnail", "overlay"]},
        "storage_ref": {"type": "string", "minLength": 5},
        "content_hash_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "rights": {
          "type": "object", "additionalProperties": false,
          "required": ["basis", "record_id", "human_checked"],
          "properties": {
            "basis": {"type": "string", "enum": ["original", "licensed", "public_domain"]},
            "record_id": {"type": "string", "minLength": 3},
            "human_checked": {"type": "boolean"}
          }
        }
      }
    },
    "character": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "rig_asset_id", "voice_profile_id"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "rig_asset_id": {"$ref": "#/$defs/identifier"},
        "voice_profile_id": {"type": "string", "minLength": 2},
        "description": {"type": "string"}
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_type", "zoom_start", "zoom_end"],
      "properties": {
        "shot_type": {"type": "string", "enum": ["wide", "medium", "closeup", "insert", "over_shoulder"]},
        "zoom_start": {"type": "number", "minimum": 0.5, "maximum": 3},
        "zoom_end": {"type": "number", "minimum": 0.5, "maximum": 3},
        "pan_x": {"type": "number", "minimum": -1, "maximum": 1},
        "pan_y": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "primitive", "start_frame", "duration_frames"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/identifier"},
        "primitive": {"type": "string", "enum": ["hold", "idle", "blink", "talk", "glance", "head_tilt", "walk", "point", "pick_up", "drop", "shake", "squash", "jump", "recoil"]},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "params": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "boolean"]}}
      }
    },
    "dialogue": {
      "type": "object", "additionalProperties": false,
      "required": ["line_id", "speaker_id", "text", "start_frame", "duration_frames", "emotion", "audio_ref"],
      "properties": {
        "line_id": {"$ref": "#/$defs/identifier"},
        "speaker_id": {"$ref": "#/$defs/identifier"},
        "text": {"type": "string", "minLength": 1, "maxLength": 700},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "emotion": {"type": "string", "enum": ["neutral", "dry", "surprised", "fearful", "angry", "joyful", "whisper"]},
        "audio_ref": {"type": ["string", "null"]},
        "viseme_ref": {"type": ["string", "null"]}
      }
    },
    "sound": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "start_frame", "duration_frames", "gain_db"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/identifier"},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "gain_db": {"type": "number", "minimum": -80, "maximum": 12}
      }
    },
    "shot": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_id", "start_frame", "duration_frames", "background_asset_id", "camera", "characters_present", "actions", "dialogue", "sounds", "story_purpose"],
      "properties": {
        "shot_id": {"$ref": "#/$defs/identifier"},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "background_asset_id": {"$ref": "#/$defs/identifier"},
        "camera": {"$ref": "#/$defs/camera"},
        "characters_present": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "prop_asset_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "dialogue": {"type": "array", "items": {"$ref": "#/$defs/dialogue"}},
        "sounds": {"type": "array", "items": {"$ref": "#/$defs/sound"}},
        "story_purpose": {"type": "string", "minLength": 5},
        "editor_notes": {"type": "string"}
      }
    }
  }
}
